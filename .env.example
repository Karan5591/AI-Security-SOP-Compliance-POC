# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres / pgvector
DATABASE_URL=postgresql://postgres:postgres@db:5432/secsop

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM gateway (Llama 3 70B or any OpenAI-chat-compatible endpoint)
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=changeme
LLM_MODEL=llama3-70b
LLM_TIMEOUT_SECONDS=120

# RAG
TOP_K_RULES=5

APP_NAME=AI-Security-SOP-Compliance-POC
LOG_LEVEL=INFO

# CI gate. Unknown severity always blocks. Leave override empty to disable waivers.
BLOCKING_SEVERITIES=CRITICAL,HIGH
SECURITY_OVERRIDE_TOKEN=
MAX_BATCH_FILES=100
MAX_FILE_BYTES=512000

# Jenkins local Docker lab
# Jenkins reaches the API over the Compose network, so use this as the
# Jenkins secret-text credential named security-api-url.
# SECURITY_API_URL=http://api:8000

# API auth - required on /sop/* and /review via the X-API-Key header.
# Generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-please-set-a-real-key
